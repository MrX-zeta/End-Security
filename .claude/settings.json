{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew testDebugUnitTest *)",
      "Bash(./gradlew testDebugUnitTest)",
      "Bash(./gradlew lintDebug)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./keystore.properties)",
      "Read(./**/secrets/**)"
    ]
  }
}
